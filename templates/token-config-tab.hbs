<div class="form-group">
  <label>{{localize "DYNAMIC_TOKENS.TrackedAttribute"}}</label>
  <div class="form-fields">
    <select class="dt-attribute">
      <option value="">{{localize "DYNAMIC_TOKENS.None"}}</option>
    </select>
  </div>
  <p class="hint">{{localize "DYNAMIC_TOKENS.TrackedAttributeHint"}}</p>
</div>

<div class="form-group dt-preview-group">
  <label>{{localize "DYNAMIC_TOKENS.PreviewHp"}}</label>
  <div class="form-fields">
    <input type="range" class="dt-preview-slider" min="0" max="100" step="1" value="{{previewPercent}}" />
    <span class="dt-preview-value">{{previewPercent}}%</span>
    <img class="dt-thumb dt-preview-thumb empty" src="" alt="" />
  </div>
  <p class="hint">{{localize "DYNAMIC_TOKENS.PreviewHpHint"}}</p>
</div>

<div class="dynamic-tokens-thresholds">
  {{#each thresholds}}
  <div class="threshold-row" data-index="{{@index}}">
    <div class="form-fields">
      <label>{{localize "DYNAMIC_TOKENS.HpAtMost"}}</label>
      <input type="number" class="dt-threshold" value="{{this.threshold}}" min="0" max="100" step="1" placeholder="%" />
      <span>%</span>
      <img class="dt-thumb{{#unless this.img}} empty{{/unless}}" src="{{this.img}}" alt="" />
      <input type="text" class="dt-img" value="{{this.img}}" placeholder="{{localize "DYNAMIC_TOKENS.ImagePlaceholder"}}" />
      <button type="button" class="dt-file-picker" title="{{localize "DYNAMIC_TOKENS.BrowseFiles"}}">
        <i class="fa-solid fa-file-import"></i>
      </button>
      <button type="button" class="dt-remove" title="{{localize "DYNAMIC_TOKENS.RemoveThreshold"}}">
        <i class="fa-solid fa-trash"></i>
      </button>
    </div>
  </div>
  {{/each}}
</div>
<button type="button" class="dt-add-threshold">
  <i class="fa-solid fa-plus"></i> {{localize "DYNAMIC_TOKENS.AddThreshold"}}
</button>

<button type="button" class="dt-advanced-open">
  <i class="fa-solid fa-sliders"></i> {{localize "DYNAMIC_TOKENS.AdvancedButton"}}
</button>
